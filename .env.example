STOCK_AUTH_BASE_URL=http://localhost:9000
STOCK_CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# Local direct mode: Eureka/Discovery off, auth-back direct.
# spring.profiles.active=local-direct

# Gateway/Eureka mode.
# spring.profiles.active=local

STOCK_OPENING_GRANT_AMOUNT=10000000

# Read-side only protection for execution-ledger aggregate endpoints.
# These values do not add writes or locks to order placement/matching transactions.
STOCK_ORDER_BOOK_TRADE_SUMMARY_CACHE_TTL_MS=10000
STOCK_ORDER_BOOK_CANDLE_CACHE_TTL_MS=10000
STOCK_ORDER_BOOK_LIVE_AGGREGATE_CACHE_MAX_ENTRIES=1000
